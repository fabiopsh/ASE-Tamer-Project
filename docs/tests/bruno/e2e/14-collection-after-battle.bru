meta {
  name: GET /api/collection?run_id={{runId}} - reward only on victory
  type: http
  seq: 14
}

get {
  url: {{monstersUrl}}/api/collection?run_id={{runId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{playerToken}}
}

tests {
  test("Four monsters after a victory, three after a defeat", () => {
    expect(res.getStatus()).to.equal(200);
    var items = res.getBody().items;
    if (bru.getVar("outcome") === "victory") {
      expect(items).to.have.lengthOf(4);
      expect(items.some(i => i.monster_id === bru.getVar("rewardMonsterId") && i.source === "encounter")).to.equal(true);
    } else {
      expect(items).to.have.lengthOf(3);
    }
  });
}
