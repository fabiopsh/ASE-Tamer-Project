meta {
  name: POST /api/teams/validate - team of three
  type: http
  seq: 7
}

post {
  url: {{teamsUrl}}/api/teams/validate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{playerToken}}
}

body:json {
  {"members":["{{owned1}}","{{owned2}}","{{owned3}}"]}
}

tests {
  test("Team is valid", () => {expect(res.getStatus()).to.equal(200); expect(res.getBody().valid).to.equal(true);});
}
