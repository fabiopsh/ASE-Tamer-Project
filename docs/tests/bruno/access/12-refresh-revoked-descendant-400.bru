meta {
  name: 12 - Rotated descendant revoked after reuse
  type: http
  seq: 12
}

post {
  url: {{authUrl}}/api/auth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: refresh_token
  refresh_token: {{accRefresh1Rotated}}
}

tests {
  test("400 invalid_grant because whole family was revoked", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("invalid_grant");
  });
}
