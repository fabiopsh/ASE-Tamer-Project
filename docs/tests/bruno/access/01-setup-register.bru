meta {
  name: 01 - Register player for access matrix
  type: http
  seq: 1
}

post {
  url: {{authUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "{{accUser}}",
    "password": "access-pass-123"
  }
}

script:pre-request {
  bru.setVar("accUser", "acc_" + Math.random().toString(16).slice(2, 12));
}

tests {
  test("201 registered", function () {
    expect(res.getStatus()).to.equal(201);
    bru.setVar("accPlayerId", res.getBody().player_id);
  });
}
