meta {
  name: 11 - Refresh reuse rejected and revokes family
  type: http
  seq: 11
}

post {
  url: {{authUrl}}/api/auth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: refresh_token
  refresh_token: {{accRefresh1}}
}

tests {
  test("400 invalid_grant on consumed refresh token", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("invalid_grant");
  });
}
