meta {
  name: 17 - Refresh after logout fails (400)
  type: http
  seq: 17
}

post {
  url: {{authUrl}}/api/auth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: refresh_token
  refresh_token: {{accRefresh2Rotated}}
}

tests {
  test("400 invalid_grant after logout", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("invalid_grant");
  });
}
