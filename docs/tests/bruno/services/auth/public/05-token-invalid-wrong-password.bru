meta {
  name: POST /api/auth/token - invalid: wrong password
  type: http
  seq: 5
}

post {
  url: {{authUrl}}/api/auth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  username: {{authUsername}}
  password: wrong-password
}

tests {
  test("400 invalid_grant", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("invalid_grant");
    bru.setVar("wrongPasswordDescription", res.getBody().error_description);
  });
}
