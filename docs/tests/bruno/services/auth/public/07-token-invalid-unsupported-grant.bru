meta {
  name: POST /api/auth/token - invalid: unsupported grant
  type: http
  seq: 7
}

post {
  url: {{authUrl}}/api/auth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: authorization_code
}

tests {
  test("400 unsupported_grant_type", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("unsupported_grant_type");
  });
}
