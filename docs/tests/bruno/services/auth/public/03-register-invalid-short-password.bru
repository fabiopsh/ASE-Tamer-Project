meta {
  name: POST /api/auth/register - invalid: short password
  type: http
  seq: 3
}

post {
  url: {{authUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "short_pw_user",
    "password": "1234567"
  }
}

tests {
  test("400 VALIDATION_ERROR on password", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("VALIDATION_ERROR");
    expect(res.getBody().details.map((d) => d.field)).to.include("password");
  });
}
