meta {
  name: POST /api/auth/token - valid: refresh_token grant
  type: http
  seq: 8
}

post {
  url: {{authUrl}}/api/auth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: refresh_token
  refresh_token: {{playerRefreshToken}}
}

tests {
  test("200 rotated access and refresh tokens", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("cache-control")).to.include("no-store");
    const body = res.getBody();
    expect(body.expires_in).to.equal(300);
    expect(body.refresh_token).to.not.equal(bru.getVar("playerRefreshToken"));
    bru.setVar("playerRefreshToken", body.refresh_token);
  });
}
