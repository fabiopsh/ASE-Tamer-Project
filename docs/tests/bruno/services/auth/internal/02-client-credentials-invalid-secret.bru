meta {
  name: POST /internal/auth/token - invalid: wrong client secret
  type: http
  seq: 2
}

post {
  url: {{authUrl}}/internal/auth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: tests
  client_secret: wrong-secret
}

tests {
  test("401 invalid_client", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error).to.equal("invalid_client");
  });
}
