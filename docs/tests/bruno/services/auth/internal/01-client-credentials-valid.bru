meta {
  name: POST /internal/auth/token - valid: client credentials
  type: http
  seq: 1
}

post {
  url: {{authUrl}}/internal/auth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: client_credentials
  client_id: tests
  client_secret: {{process.env.TESTS_CLIENT_SECRET}}
}

tests {
  test("200 service token", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.token_type).to.equal("Bearer");
    expect(body.scope).to.equal("service");
    expect(body.expires_in).to.equal(300);
    bru.setVar("serviceToken", body.access_token);
  });
}
