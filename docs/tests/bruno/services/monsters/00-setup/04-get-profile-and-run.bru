meta {
  name: GET /api/players/me - profile and run
  type: http
  seq: 4
}

get {
  url: {{playersUrl}}/api/players/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{playerToken}}
}

tests {
  test("Profile has run id", () => {expect(res.getStatus()).to.equal(200); bru.setVar("runId", res.getBody().current_run_id);});
}
