meta {
  name: POST /internal/collections/{{playerId}}/starters - invalid
  type: http
  seq: 15
}

post {
  url: {{monstersUrl}}/internal/collections/{{playerId}}/starters
  body: json
  auth: bearer
}

auth:bearer {
  token: {{serviceToken}}
}

body:json {
  {"run_id":"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee","monster_ids":[{{starter1}},{{starter2}}]}
}

tests {
  test("Invalid request is rejected", () => {expect(res.getStatus()).to.equal(400); expect(res.getBody().error).to.equal("INVALID_COLLECTION_OPERATION");});
}
