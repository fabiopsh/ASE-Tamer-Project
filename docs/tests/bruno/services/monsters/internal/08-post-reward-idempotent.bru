meta {
  name: POST /internal/collections/{{playerId}}/monsters - reward idempotent
  type: http
  seq: 8
}

post {
  url: {{monstersUrl}}/internal/collections/{{playerId}}/monsters
  body: json
  auth: bearer
}

auth:bearer {
  token: {{serviceToken}}
}

body:json {
  {"run_id":"{{runId}}","monster_id":1,"level":7,"encounter_id":"{{encounterId}}","source":"encounter"}
}

tests {
  test("Repeated reward yields same monster", () => {expect(res.getStatus()).to.equal(200); expect(res.getBody().owned_id).to.equal(bru.getVar("rewardId"));});
}
