meta {
  name: GET /internal/collections/{{playerId}}/instances?ids={{owned1}},{{owned2}} - instances valid
  type: http
  seq: 11
}

get {
  url: {{monstersUrl}}/internal/collections/{{playerId}}/instances?ids={{owned1}},{{owned2}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{serviceToken}}
}

tests {
  test("Returns full owned instance stats", () => {expect(res.getStatus()).to.equal(200); expect(res.getBody()).to.have.lengthOf(2); expect(res.getBody()[0].stats).to.have.property("attack");});
}
