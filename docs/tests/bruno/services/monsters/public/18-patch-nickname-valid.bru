meta {
  name: PATCH /api/collection/{{owned1}} - valid: set nickname (US-13)
  type: http
  seq: 18
}

patch {
  url: {{monstersUrl}}/api/collection/{{owned1}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{playerToken}}
}

body:json {
  {
    "nickname": "Sparky"
  }
}

tests {
  test("200 updated nickname", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().nickname).to.equal("Sparky");
  });
}
