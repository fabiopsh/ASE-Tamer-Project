meta {
  name: PATCH /api/collection/{{owned1}} - invalid: illegal characters (US-13)
  type: http
  seq: 19
}

patch {
  url: {{monstersUrl}}/api/collection/{{owned1}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{playerToken}}
}

body:json {
  {
    "nickname": "<script>bad</script>"
  }
}

tests {
  test("400 VALIDATION_ERROR", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("VALIDATION_ERROR");
  });
}
