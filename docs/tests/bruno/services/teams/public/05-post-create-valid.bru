meta {
  name: POST /api/teams - create valid
  type: http
  seq: 5
}

post {
  url: {{teamsUrl}}/api/teams
  body: json
  auth: bearer
}

auth:bearer {
  token: {{playerToken}}
}

body:json {
  {"name":"Second","members":["{{owned2}}","{{owned3}}"]}
}

tests {
  test("Second team created", () => {expect(res.getStatus()).to.equal(201); bru.setVar("secondTeamId",res.getBody().team_id);});
}
