meta {
  name: POST /api/teams - create invalid size
  type: http
  seq: 6
}

post {
  url: {{teamsUrl}}/api/teams
  body: json
  auth: bearer
}

auth:bearer {
  token: {{playerToken}}
}

body:json {
  {"name":"Too many","members":["{{owned1}}","{{owned2}}","{{owned3}}","{{owned1}}"]}
}

tests {
  test("400 TEAM_INVALID with rule code", () => {expect(res.getStatus()).to.equal(400); expect(res.getBody().error).to.equal("TEAM_INVALID");});
}
