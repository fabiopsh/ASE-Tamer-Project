meta {
  name: POST /internal/collections/{{playerId}}/starters - grant test starters
  type: http
  seq: 6
}

post {
  url: {{monstersUrl}}/internal/collections/{{playerId}}/starters
  body: json
  auth: bearer
}

auth:bearer {
  token: {{serviceToken}}
}

body:json {
  {"run_id":"{{runId}}","monster_ids":[{{starter1}},{{starter2}},{{starter3}}]}
}

tests {
  test("Create owned instances", () => {expect(res.getStatus()).to.equal(201); var items = res.getBody(); bru.setVar("owned1",items[0].owned_id); bru.setVar("owned2",items[1].owned_id); bru.setVar("owned3",items[2].owned_id);});
}
