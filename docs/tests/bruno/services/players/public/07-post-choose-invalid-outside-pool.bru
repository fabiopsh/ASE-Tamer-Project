meta {
  name: POST /api/players/me/starters - invalid: starter outside the pool
  type: http
  seq: 7
}

post {
  url: {{playersUrl}}/api/players/me/starters
  body: json
  auth: bearer
}

auth:bearer {
  token: {{playerToken}}
}

body:json {
  {"monster_ids":[{{starter1}},{{starter2}},{{outsider}}]}
}

script:pre-request {
  var pool = JSON.parse(bru.getVar("starterPool"));
  var outsider = 1;
  while (pool.includes(outsider)) { outsider++; }
  bru.setVar("outsider", outsider);
}

tests {
  test("400 INVALID_STARTERS", () => {expect(res.getStatus()).to.equal(400); expect(res.getBody().error).to.equal("INVALID_STARTERS");});
}
