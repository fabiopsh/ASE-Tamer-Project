meta {
  name: PATCH /api/players/me - invalid: unknown avatar (US-04)
  type: http
  seq: 11
}

patch {
  url: {{playersUrl}}/api/players/me
  body: json
  auth: bearer
}

auth:bearer {
  token: {{playerToken}}
}

body:json {
  {
    "avatar": "not-a-valid-avatar"
  }
}

tests {
  test("400 VALIDATION_ERROR", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("VALIDATION_ERROR");
  });
}
