meta {
  name: GET /api/players/me - profile valid
  type: http
  seq: 1
}

get {
  url: {{playersUrl}}/api/players/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{playerToken}}
}

tests {
  test("Profile scoped to token", () => {expect(res.getStatus()).to.equal(200); expect(res.getBody().player_id).to.equal(bru.getVar("playerId"));});
}
