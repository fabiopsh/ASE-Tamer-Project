meta {
  name: POST /api/players/me/starters - choose invalid duplicate
  type: http
  seq: 5
}

post {
  url: {{playersUrl}}/api/players/me/starters
  body: json
  auth: bearer
}

auth:bearer {
  token: {{playerToken}}
}

body:json {
  {"monster_ids":[{{starter1}},{{starter1}},{{starter3}}]}
}

tests {
  test("Duplicate rejected", () => {expect(res.getStatus()).to.equal(400); expect(res.getBody().error).to.equal("INVALID_STARTERS");});
}
