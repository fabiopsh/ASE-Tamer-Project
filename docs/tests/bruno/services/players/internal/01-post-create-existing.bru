meta {
  name: POST /internal/players - create existing
  type: http
  seq: 1
}

post {
  url: {{playersUrl}}/internal/players
  body: json
  auth: bearer
}

auth:bearer {
  token: {{serviceToken}}
}

body:json {
  {"player_id":"{{playerId}}"}
}

tests {
  test("Idempotent profile creation", () => {expect(res.getStatus()).to.equal(200); expect(res.getBody().player_id).to.equal(bru.getVar("playerId"));});
}
