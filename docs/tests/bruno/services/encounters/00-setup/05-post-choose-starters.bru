meta {
  name: POST /api/players/me/starters - choose starters (opens the run in encounters)
  type: http
  seq: 5
}

post {
  url: {{playersUrl}}/api/players/me/starters
  body: json
  auth: bearer
}

auth:bearer {
  token: {{playerToken}}
}

body:json {
  {"monster_ids":[{{starter1}},{{starter2}},{{starter3}}]}
}

tests {
  test("Starters granted and run opened", () => {expect(res.getStatus()).to.equal(201); var b = res.getBody(); bru.setVar("runId", b.run_id); bru.setVar("owned1", b.starters[0].owned_id); bru.setVar("owned2", b.starters[1].owned_id); bru.setVar("owned3", b.starters[2].owned_id);});
}
