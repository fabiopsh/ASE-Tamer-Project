meta {
  name: POST /internal/runs - second active run
  type: http
  seq: 2
}

post {
  url: {{encountersUrl}}/internal/runs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{serviceToken}}
}

body:json {
  {"run_id":"{{otherRunId}}","player_id":"{{playerId}}"}
}

script:pre-request {
  bru.setVar("otherRunId", "xxxxxxxx-xxxx-4xxx-8xxx-xxxxxxxxxxxx".replace(/x/g, () => Math.floor(Math.random() * 16).toString(16)));
}

tests {
  test("409 RUN_CONFLICT", () => {expect(res.getStatus()).to.equal(409); expect(res.getBody().error).to.equal("RUN_CONFLICT");});
}
