meta {
  name: POST /internal/history - invalid: missing wild monster
  type: http
  seq: 4
}

post {
  url: {{historyUrl}}/internal/history
  body: json
  auth: bearer
}

auth:bearer {
  token: {{serviceToken}}
}

body:json {
  {"encounter_id":"{{encounterId3}}","player_id":"{{playerId}}","run_id":"{{otherRunId}}","template":{"template_id":12,"name":"Mossy Hollow","stage":1,"element":"echo","is_boss":false},"outcome":"victory","engine_version":1,"started_at":"2026-11-06T11:00:00Z","ended_at":"2026-11-06T11:05:00Z"}
}

tests {
  test("400 naming the field", () => {expect(res.getStatus()).to.equal(400); expect(res.getBody().error).to.equal("VALIDATION_ERROR"); expect(res.getBody().details.map(d => d.field)).to.include("wild");});
}
