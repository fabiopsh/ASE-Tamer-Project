meta {
  name: POST /internal/history - store valid
  type: http
  seq: 1
}

post {
  url: {{historyUrl}}/internal/history
  body: json
  auth: bearer
}

auth:bearer {
  token: {{serviceToken}}
}

body:json {
  {"encounter_id":"{{encounterId3}}","player_id":"{{playerId}}","run_id":"{{otherRunId}}","template":{"template_id":12,"name":"Mossy Hollow","stage":1,"element":"echo","is_boss":false},"wild":{"monster_id":51,"name":"Mossling","level":2,"rarity":"common","element":"echo"},"team_snapshot":[{"position":1,"owned_id":"{{ownedId}}","monster_id":3,"name":"Emberling","level":3,"stats":{"hp":30,"attack":9}}],"outcome":"fled","reward":{"owned_id":"{{rewardOwnedId}}","monster_id":51,"level":2},"xp_gained":20,"turns":[{"turn":1,"events":[{"type":"damage","target_side":"wild","amount":7}]}],"rng_seed":"-4512345678901234567","engine_version":1,"started_at":"2026-11-06T11:00:00Z","ended_at":"2026-11-06T11:05:00Z"}
}

tests {
  test("201 with the stored summary", () => {expect(res.getStatus()).to.equal(201); var b = res.getBody(); expect(b.encounter_id).to.equal(bru.getVar("encounterId3")); expect(b.outcome).to.equal("fled"); expect(b.template.name).to.equal("Mossy Hollow"); expect(b.wild.monster_id).to.equal(51); expect(b).to.not.have.property("turns");});
}
