meta {
  name: GET /api/history - list valid (newest first)
  type: http
  seq: 1
}

get {
  url: {{historyUrl}}/api/history?run_id={{runId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{playerToken}}
}

tests {
  test("Own summaries, newest first", () => {expect(res.getStatus()).to.equal(200); var b = res.getBody(); expect(b.total_items).to.equal(2); expect(b.items.map(i => i.encounter_id)).to.eql([bru.getVar("encounterId2"), bru.getVar("encounterId1")]); expect(b.items[0]).to.include.keys("outcome", "template", "wild", "xp_gained", "started_at", "ended_at"); expect(b.items[0]).to.not.have.property("turns"); expect(b.items[0]).to.not.have.property("team_snapshot");});
}
