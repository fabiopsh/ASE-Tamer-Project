            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "disabled": false,
                  "type": "default",
                  "description": ""
                },
                {
                  "key": "username",
                  "value": "{{authUsername}}",
                  "disabled": false,
                  "type": "default",
                  "description": ""
                },
                {
                  "key": "password",
                  "value": "pikachu123",
                  "disabled": false,
                  "type": "default",
                  "description": ""
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "// Tests",
                  "test(\"200 Bearer token, not cacheable\", function () {",
                  "  expect(res.getStatus()).to.equal(200);",
                  "  expect(res.getHeader(\"cache-control\")).to.equal(\"no-store\");",
                  "  const body = res.getBody();",
                  "  expect(body.token_type).to.equal(\"Bearer\");",
                  "  expect(body.scope).to.equal(\"player\");",
                  "  expect(body.expires_in).to.be.above(0);",
                  "  expect(body.access_token.split(\".\")).to.have.lengthOf(3);",
                  "  bru.setVar(\"playerToken\", body.access_token);",
                  "});"
                ]
              }
            }
          ]
        },
