    {
      "name": "internal",
      "item": [
        {
          "name": "POST /internal/auth/token - valid: client credentials",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "description": "",
            "url": {
              "raw": "{{authUrl}}/internal/auth/token",
              "protocol": "",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "internal",
                "auth",
                "token"
              ],
              "query": [],
              "variable": []
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials",
                  "disabled": false,
                  "type": "default",
                  "description": ""
                },
                {
                  "key": "client_id",
                  "value": "tests",
                  "disabled": false,
                  "type": "default",
                  "description": ""
                },
                {
                  "key": "client_secret",
                  "value": "{{process.env.TESTS_CLIENT_SECRET}}",
                  "disabled": false,
                  "type": "default",
                  "description": ""
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "// Tests",
                  "test(\"200 service token\", function () {",
                  "  expect(res.getStatus()).to.equal(200);",
                  "  const body = res.getBody();",
                  "  expect(body.token_type).to.equal(\"Bearer\");",
                  "  expect(body.scope).to.equal(\"service\");",
                  "  expect(body.expires_in).to.equal(300);",
                  "  bru.setVar(\"serviceToken\", body.access_token);",
                  "});"
                ]
              }
            }
          ]
        },
