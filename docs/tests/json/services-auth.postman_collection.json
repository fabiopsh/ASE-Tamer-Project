    {
      "name": "public",
      "item": [
        {
          "name": "POST /api/auth/register - valid",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "description": "",
            "url": {
              "raw": "{{authUrl}}/api/auth/register",
              "protocol": "",
              "host": [
                "{{authUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ],
              "query": [],
              "variable": []
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{authUsername}}\",\n  \"password\": \"pikachu123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "bru.setVar(\"authUsername\", \"Br_\" + Math.random().toString(16).slice(2, 12));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                  "// Tests",
                  "test(\"201 with player_id and normalised username\", function () {",
                  "  expect(res.getStatus()).to.equal(201);",
                  "  expect(res.getBody().player_id).to.match(/^[0-9a-f-]{36}$/);",
                  "  expect(res.getBody().username).to.equal(bru.getVar(\"authUsername\").toLowerCase());",
                  "});"
                ]
              }
            }
          ]
        },
