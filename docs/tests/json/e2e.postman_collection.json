    {
      "name": "POST /api/battles/current/actions - attack until the battle ends",
      "request": {
        "method": "POST",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{playerToken}}",
              "type": "string"
            }
          ]
        },
        "description": "",
