# Monster Tamers gateway - docs/plan/02-infrastructure.md (INFRA-5)
# Variables in ${...} are substituted from the environment at start; nginx variables ($x) are not.

# Docker DNS: resolve the services at request time, so a restarted service is found again.
resolver 127.0.0.11 valid=10s ipv6=off;

# Brute force protection on login and registration
limit_req_zone $binary_remote_addr zone=auth:10m rate=${LOGIN_RATE_LIMIT};
limit_req_status 429;

# CORS: only the Vite dev server and preview are allowed (never *)
map $http_origin $cors_origin {
    default                  "";
    "http://localhost:5173"  $http_origin;
    "http://localhost:4173"  $http_origin;
}

log_format tamer '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                 'rid=$request_id rt=$request_time';

server {
    listen 8443 ssl;
    http2 on;
    server_name localhost;

    ssl_certificate     /run/secrets/tls/server.crt;
    ssl_certificate_key /run/secrets/tls/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    server_tokens off;
    client_max_body_size 16k;
    access_log /dev/stdout tamer;

    # Security headers (also on errors)
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Request-Id $request_id always;
    # CORS (an empty value means the header is not sent)
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-Request-Id" always;
    add_header Access-Control-Expose-Headers "X-Request-Id" always;
    add_header Access-Control-Max-Age "600" always;
    add_header Vary "Origin" always;

    # CORS preflight
    if ($request_method = OPTIONS) {
        return 204;
    }

    default_type application/json;
    error_page 413 = @too_large;
    error_page 429 = @too_many;
    error_page 502 503 504 = @unavailable;

    # Used to accept the self-signed certificate in the browser and by health checks
    location = /health {
        return 200 '{"status":"UP"}';
    }

    # ---- auth ----
    location = /api/auth/token {
        limit_req zone=auth burst=${LOGIN_RATE_BURST} nodelay;
        set $upstream_host auth;
        include /etc/nginx/snippets/proxy.conf;
    }
    location = /api/auth/register {
        limit_req zone=auth burst=${LOGIN_RATE_BURST} nodelay;
        set $upstream_host auth;
        include /etc/nginx/snippets/proxy.conf;
    }
    location /api/auth/ {
        set $upstream_host auth;
        include /etc/nginx/snippets/proxy.conf;
    }

    # ---- players ----
    location /api/players/ {
        set $upstream_host players;
        include /etc/nginx/snippets/proxy.conf;
    }

    # ---- monsters (images are public, P-16) ----
    location ~ ^/api/(monsters|abilities|elements|collection)(/|$) {
        set $upstream_host monsters;
        include /etc/nginx/snippets/proxy.conf;
    }
    location /images/ {
        set $upstream_host monsters;
        include /etc/nginx/snippets/proxy.conf;
    }

    # ---- teams ----
    location ~ ^/api/teams(/|$) {
        set $upstream_host teams;
        include /etc/nginx/snippets/proxy.conf;
    }

    # ---- encounters ----
    location ~ ^/api/(encounters|runs|battles)(/|$) {
        set $upstream_host encounters;
        include /etc/nginx/snippets/proxy.conf;
    }

    # ---- history ----
    location ~ ^/api/history(/|$) {
        set $upstream_host history;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Internal APIs and Quarkus endpoints are never exposed; neither is anything else
    location /internal/ {
        return 404 '{"error":"NOT_FOUND","message":"Resource not found."}';
    }
    location /q/ {
        return 404 '{"error":"NOT_FOUND","message":"Resource not found."}';
    }
    location / {
        return 404 '{"error":"NOT_FOUND","message":"Resource not found."}';
    }

    location @too_large {
        return 413 '{"error":"PAYLOAD_TOO_LARGE","message":"Request body too large."}';
    }
    location @too_many {
        return 429 '{"error":"TOO_MANY_REQUESTS","message":"Too many requests, retry later."}';
    }
    location @unavailable {
        return 503 '{"error":"DEPENDENCY_UNAVAILABLE","message":"Service temporarily unavailable."}';
    }
}
